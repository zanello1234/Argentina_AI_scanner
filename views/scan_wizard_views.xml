<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_ar_ai_scan_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ar.ai.scan.wizard.form</field>
        <field name="model">l10n_ar.ai.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Escanear Comprobante con IA">
                <sheet>

                    <!-- Header: state + scan button -->
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'ready'">
                        <i class="fa fa-info-circle"/> Haga clic en <strong>Escanear</strong> para analizar el comprobante adjunto.
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'scanned'">
                        <i class="fa fa-check-circle"/> Escaneo completado. Revise los datos extraídos y presione <strong>Aplicar</strong> para guardarlos en la factura.
                    </div>

                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'error'">
                        <i class="fa fa-times-circle"/> <strong>Error durante el escaneo:</strong>
                        <field name="error_message" nolabel="1" readonly="1" widget="text"/>
                    </div>

                    <group>
                        <field name="move_id" readonly="1"/>
                        <field name="state" invisible="1"/>
                    </group>

                    <!-- Extracted fields (visible after scan) -->
                    <group invisible="state == 'ready'">

                        <group string="Identificación del Comprobante">
                            <field name="apply_tipo_comprobante" widget="boolean_toggle"/>
                            <field name="tipo_comprobante"
                                   readonly="not apply_tipo_comprobante"/>
                            <field name="apply_numero" widget="boolean_toggle"/>
                            <field name="punto_de_venta"
                                   readonly="not apply_numero"/>
                            <field name="numero_comprobante"
                                   readonly="not apply_numero"/>
                            <field name="apply_fecha" widget="boolean_toggle"/>
                            <field name="fecha_emision"
                                   readonly="not apply_fecha"/>
                        </group>

                        <group string="Emisor">
                            <field name="apply_cuit_emisor" widget="boolean_toggle"/>
                            <field name="cuit_emisor"
                                   readonly="not apply_cuit_emisor"/>
                            <field name="razon_social_emisor"/>
                            <field name="create_partner_if_missing" widget="boolean_toggle"
                                   invisible="not apply_cuit_emisor"/>
                        </group>

                        <group string="Receptor">
                            <field name="cuit_receptor"/>
                            <field name="razon_social_receptor"/>
                        </group>

                        <group string="CAE / Autorización AFIP">
                            <field name="apply_cae" widget="boolean_toggle"/>
                            <field name="cae"
                                   readonly="not apply_cae"/>
                            <field name="vencimiento_cae"
                                   readonly="not apply_cae"/>
                        </group>

                        <group string="Importes">
                            <field name="apply_amounts" widget="boolean_toggle"/>
                            <field name="neto_gravado_21"
                                   readonly="not apply_amounts"/>
                            <field name="neto_gravado_105"
                                   readonly="not apply_amounts"/>
                            <field name="neto_gravado_27"
                                   readonly="not apply_amounts"/>
                            <field name="neto_no_gravado"
                                   readonly="not apply_amounts"/>
                            <field name="exento"
                                   readonly="not apply_amounts"/>
                            <field name="iva_21"
                                   readonly="not apply_amounts"/>
                            <field name="iva_105"
                                   readonly="not apply_amounts"/>
                            <field name="iva_27"
                                   readonly="not apply_amounts"/>
                            <field name="otros_tributos"
                                   readonly="not apply_amounts"/>
                            <field name="importe_total"
                                   readonly="not apply_amounts"/>
                            <field name="moneda"/>
                        </group>

                        <group string="Confianza y Observaciones">
                            <field name="confianza" widget="progressbar"/>
                            <field name="observaciones" widget="text"/>
                        </group>

                    </group>

                    <!-- Raw JSON (collapsed) -->
                    <group invisible="state == 'ready'">
                        <field name="raw_json" widget="text" nolabel="1"
                               string="JSON Completo"
                               invisible="not raw_json"/>
                    </group>

                </sheet>

                <footer>
                    <!-- State: ready -->
                    <button
                        name="action_scan"
                        type="object"
                        string="Escanear"
                        class="btn btn-primary"
                        icon="fa-search"
                        invisible="state != 'ready'"
                    />
                    <!-- State: scanned -->
                    <button
                        name="action_apply"
                        type="object"
                        string="Aplicar datos a la factura"
                        class="btn btn-success"
                        icon="fa-check"
                        invisible="state != 'scanned'"
                    />
                    <button
                        name="action_scan"
                        type="object"
                        string="Re-escanear"
                        class="btn btn-secondary"
                        icon="fa-refresh"
                        invisible="state not in ('scanned', 'error')"
                    />
                    <button
                        name="action_discard"
                        type="object"
                        string="Cancelar"
                        class="btn btn-default"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>
