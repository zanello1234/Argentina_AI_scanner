<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Bulk Scan Wizard Form View
    ============================================================ -->
    <record id="view_l10n_ar_ai_bulk_scan_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ar.ai.bulk.scan.wizard.form</field>
        <field name="model">l10n_ar.ai.bulk.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Carga Masiva de Comprobantes con IA">
                <sheet>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'draft'">
                        <i class="fa fa-info-circle"/>
                        Seleccione los archivos PDF o imágenes de los comprobantes a procesar.
                        Se creará una factura por cada archivo y se escaneará automáticamente con IA.
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'processing'">
                        <i class="fa fa-spinner fa-spin"/>
                        Procesando comprobantes... Por favor espere.
                    </div>

                    <div class="alert alert-success" role="alert"
                         invisible="state != 'done'">
                        <i class="fa fa-check-circle"/>
                        Procesamiento completado.
                    </div>

                    <!-- File selection (draft state) -->
                    <group invisible="state != 'draft'">
                        <group>
                            <field name="move_type"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="auto_apply"/>
                            <field name="create_partner"
                                   invisible="not auto_apply"/>
                        </group>
                    </group>

                    <group invisible="state != 'draft'">
                        <field name="file_ids" widget="many2many_binary"
                               string="Archivos (PDF / Imágenes)"
                               nolabel="1"/>
                    </group>

                    <field name="state" invisible="1"/>

                    <!-- Results (done state) -->
                    <group invisible="state != 'done'">
                        <field name="result_summary" nolabel="1"
                               widget="html" colspan="2"/>
                    </group>

                </sheet>

                <footer>
                    <button name="action_process"
                            type="object"
                            string="Procesar Comprobantes"
                            class="btn btn-primary"
                            icon="fa-upload"
                            invisible="state != 'draft'"/>
                    <button string="Cerrar"
                            class="btn btn-secondary"
                            special="cancel"
                            invisible="state == 'draft'"/>
                    <button string="Cancelar"
                            class="btn btn-secondary"
                            special="cancel"
                            invisible="state != 'draft'"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Menu Action
    ============================================================ -->
    <record id="action_l10n_ar_ai_bulk_scan_wizard" model="ir.actions.act_window">
        <field name="name">Carga Masiva de Comprobantes IA</field>
        <field name="res_model">l10n_ar.ai.bulk.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_l10n_ar_ai_bulk_scan"
              name="Carga Masiva IA"
              parent="account.menu_finance_payables"
              action="action_l10n_ar_ai_bulk_scan_wizard"
              sequence="99"/>

</odoo>
