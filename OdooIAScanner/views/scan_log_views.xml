<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         List view
    ============================================================ -->
    <record id="view_l10n_ar_ai_scan_log_list" model="ir.ui.view">
        <field name="name">l10n_ar.ai.scan.log.list</field>
        <field name="model">l10n_ar.ai.scan.log</field>
        <field name="arch" type="xml">
            <list string="Registros de Escaneo IA" decoration-danger="not success" decoration-success="success">
                <field name="scan_date"/>
                <field name="move_id"/>
                <field name="ai_model"/>
                <field name="success" widget="boolean_toggle"/>
                <field name="confidence_score" string="Confianza (%)" digits="[3,1]"/>
                <field name="tokens_used"/>
                <field name="scan_duration" string="Duración (s)" digits="[6,3]"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Form view
    ============================================================ -->
    <record id="view_l10n_ar_ai_scan_log_form" model="ir.ui.view">
        <field name="name">l10n_ar.ai.scan.log.form</field>
        <field name="model">l10n_ar.ai.scan.log</field>
        <field name="arch" type="xml">
            <form string="Registro de Escaneo IA" create="false">
                <sheet>
                    <group>
                        <group string="Información General">
                            <field name="move_id"/>
                            <field name="scan_date"/>
                            <field name="ai_model"/>
                            <field name="success" widget="boolean_toggle"/>
                            <field name="confidence_score"/>
                        </group>
                        <group string="Métricas">
                            <field name="tokens_used"/>
                            <field name="scan_duration"/>
                        </group>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message" nolabel="1" widget="text"/>
                    </group>
                    <notebook>
                        <page string="Datos Extraídos">
                            <field name="extracted_data" widget="text" nolabel="1"/>
                        </page>
                        <page string="Respuesta Cruda">
                            <field name="raw_response" widget="text" nolabel="1"/>
                        </page>
                        <page string="Prompt">
                            <field name="raw_prompt" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Action and menu
    ============================================================ -->
    <record id="action_l10n_ar_ai_scan_log" model="ir.actions.act_window">
        <field name="name">Registros de Escaneo IA</field>
        <field name="res_model">l10n_ar.ai.scan.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay registros de escaneo todavía.
            </p>
            <p>
                Escanee un comprobante fiscal argentino usando el botón
                <strong>Escanear con IA</strong> en el formulario de la factura.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_l10n_ar_ai_scan_log"
        name="Registros de Escaneo IA"
        parent="account.menu_finance_entries"
        action="action_l10n_ar_ai_scan_log"
        sequence="99"
    />

</odoo>
