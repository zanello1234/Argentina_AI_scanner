<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Stat button for AI scan on invoice form
    ============================================================ -->
    <record id="view_move_form_ai_scan_button" model="ir.ui.view">
        <field name="name">account.move.form.ai.scan.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Banner: queued for AI scanning -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info text-center" role="alert"
                     invisible="ai_scan_state != 'queued'">
                    <i class="fa fa-clock-o me-1"/> Este comprobante está en cola para escaneo con IA.
                </div>
                <div class="alert alert-warning text-center" role="alert"
                     invisible="ai_scan_state != 'scanning'">
                    <i class="fa fa-spinner fa-spin me-1"/> Escaneando con IA...
                </div>
            </xpath>

            <!-- Add stat button in the button box -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_open_scan_wizard"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-search"
                    invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="ai_scan_confidence" widget="float" digits="[3,1]" nolabel="1"/>%
                        </span>
                        <span class="o_stat_text">Escaneo IA</span>
                    </div>
                </button>
            </xpath>

            <!-- Add AI scan fields tab -->
            <xpath expr="//notebook" position="inside">
                <page
                    string="Escaneo IA AFIP"
                    name="ai_scan_page"
                    invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                >
                    <group>
                        <group string="Estado del Escaneo">
                            <field name="ai_scan_state" widget="statusbar"
                                   statusbar_visible="draft,queued,scanning,done,error"/>
                            <field name="ai_scan_confidence"/>
                        </group>
                        <group string="Datos Extraídos por IA">
                            <field name="ai_scanned_cuit_emisor"/>
                            <field name="ai_scanned_cae"/>
                            <field name="ai_scanned_doc_number"/>
                        </group>
                    </group>
                    <group string="Resultado Bruto">
                        <field name="ai_scan_raw_result" widget="text" nolabel="1"
                               invisible="not ai_scan_raw_result"/>
                    </group>
                    <div class="o_row">
                        <button
                            name="action_open_scan_wizard"
                            type="object"
                            string="Escanear con IA"
                            class="btn btn-primary"
                            icon="fa-search"
                            invisible="ai_scan_state == 'scanning'"
                        />
                        <button
                            name="action_open_scan_wizard"
                            type="object"
                            string="Re-escanear"
                            class="btn btn-secondary"
                            icon="fa-refresh"
                            invisible="ai_scan_state not in ('done', 'error')"
                        />
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ============================================================
         Action: open scan logs for a given invoice
    ============================================================ -->
    <record id="action_open_scan_logs_from_move" model="ir.actions.act_window">
        <field name="name">Registros de Escaneo IA</field>
        <field name="res_model">l10n_ar.ai.scan.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_id', '=', active_id)]</field>
        <field name="context">{'default_move_id': active_id}</field>
    </record>

</odoo>
